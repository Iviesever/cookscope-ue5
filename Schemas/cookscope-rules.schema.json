{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Iviesever/cookscope-ue5/schemas/cookscope-rules.schema.json",
  "title": "CookScope Rule Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "rules"],
  "properties": {
    "schema": {
      "const": "cookscope.rules/1"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "severity": {
      "enum": ["note", "warning", "error"]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "severity",
        "scope",
        "parameters",
        "exceptions",
        "baseline",
        "failThreshold",
        "helpUri"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "budgetBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          }
        },
        "baseline": {
          "enum": ["report-all", "report-new-or-worsened", "suppress-existing"]
        },
        "failThreshold": {
          "$ref": "#/$defs/severity"
        },
        "helpUri": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "reason"],
      "properties": {
        "selector": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}

